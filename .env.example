# Copie para .env e ajuste:  cp .env.example .env
# O .env NÃO vai para o git.

# Versão da imagem base do AdGuard Home
ADGUARD_VERSION=v0.107.80

# Credenciais do painel (usadas apenas ao gerar a config pela 1ª vez)
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=troque-esta-senha

# Idioma do painel e fuso horário
ADGUARD_LANGUAGE=pt-br
TZ=America/Sao_Paulo

# true = regera AdGuardHome.yaml do template a cada start (sobrescreve
# mudanças feitas pelo painel; um backup .bak é mantido)
ADGUARD_FORCE_CONFIG=false

# IP do host onde o DNS escuta (0.0.0.0 = todas as interfaces)
DNS_BIND_IP=0.0.0.0

# Porta do painel web no host
WEB_PORT=8080
