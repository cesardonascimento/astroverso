#!/bin/sh
set -eu

root=$(dirname "$(readlink -f "$0")")

if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
    printf '[astroverso] precisa do Python 3.11 ou mais novo\n' >&2
    exit 1
fi

PYTHONPATH="$root/packages${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m manager "$@"
